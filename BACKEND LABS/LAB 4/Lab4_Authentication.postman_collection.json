					"raw": "{{baseUrl}}/login/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"login",
						""
					]
				},
				"description": "Task 4 & 5: Successful login returns 200 OK with { jwt_token } containing only username in payload."
			},
			"response": []
