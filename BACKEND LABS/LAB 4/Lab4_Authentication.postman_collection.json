		{
			"name": "6. User Login - Success with JWT Token (POST /login/)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains jwt_token and stores in variable\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"jwt_token\");",
							"    pm.expect(jsonData.jwt_token).to.be.a(\"string\");",
							"    pm.expect(jsonData.jwt_token.length).to.be.above(20);",
							"    pm.collectionVariables.set(\"jwt_token\", jsonData.jwt_token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
